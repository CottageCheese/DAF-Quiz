@* Skeleton list rows. Usage: @await Html.PartialAsync("_SkeletonRows", 6) *@
@model int

<div class="ui-skel" aria-hidden="true" aria-busy="true">
    @for (var i = 0; i < Math.Max(1, Model); i++)
    {
        <div class="ui-skel__row">
            <div class="ui-skel__bar ui-skel__bar--sm"></div>
            <div class="ui-skel__bar"></div>
            <div class="ui-skel__bar ui-skel__bar--sm"></div>
        </div>
    }
</div>
