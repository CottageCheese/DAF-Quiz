@*
    Shared empty-state partial.
    Usage: @await Html.PartialAsync("_EmptyState", new EmptyStateModel { ... })
*@
@model QuizProject.Web.Models.ViewModels.EmptyStateModel

<div class="ui-empty" role="status">
    <div class="ui-empty__icon" aria-hidden="true">
        @if (!string.IsNullOrEmpty(Model.IconSvg))
        {
            @Html.Raw(Model.IconSvg)
        }
        else
        {
            <svg width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                 stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                <circle cx="12" cy="12" r="10"/>
                <path d="M8 15c1 1 2.5 1.5 4 1.5s3-.5 4-1.5"/>
                <path d="M9 9h.01M15 9h.01"/>
            </svg>
        }
    </div>
    <h2 class="ui-empty__title">@Model.Title</h2>
    @if (!string.IsNullOrEmpty(Model.Message))
    {
        <p class="ui-empty__msg">@Model.Message</p>
    }
    @if (!string.IsNullOrEmpty(Model.CtaText) && !string.IsNullOrEmpty(Model.CtaHref))
    {
        <a href="@Model.CtaHref" class="btn-neon">@Model.CtaText</a>
    }
</div>
