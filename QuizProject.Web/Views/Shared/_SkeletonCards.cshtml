@* Skeleton card grid. Usage: @await Html.PartialAsync("_SkeletonCards", 6) *@
@model int

<div class="ui-skel-grid" aria-hidden="true" aria-busy="true">
    @for (var i = 0; i < Math.Max(1, Model); i++)
    {
        <div class="ui-skel-card">
            <div class="ui-skel__bar ui-skel__bar--lg"></div>
            <div class="ui-skel__bar"></div>
            <div class="ui-skel__bar ui-skel__bar--sm"></div>
            <div class="ui-skel__bar"></div>
        </div>
    }
</div>
