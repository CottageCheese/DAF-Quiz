@model RegisterViewModel
@{
    ViewData["Title"] = "Create account";
    Layout = "_Layout";
}

<div class="auth-shell">
    <section class="auth-card" aria-labelledby="register-heading">
        <div class="auth-brand">
            <span class="brand-mark" aria-hidden="true"></span>
            TriviaRush
        </div>

        <h1 id="register-heading" class="auth-title">Join the rush.</h1>
        <p class="auth-sub">Create an account and climb the board.</p>

        <form asp-action="Register" method="post" novalidate>
            <input type="hidden" name="returnUrl" value="@(ViewData["ReturnUrl"] as string)"/>
            @Html.AntiForgeryToken()

            <div asp-validation-summary="ModelOnly" class="auth-alert" role="alert" aria-live="assertive"></div>

            <div class="auth-field">
                <input asp-for="DisplayName"
                       id="DisplayName"
                       class="auth-input"
                       autocomplete="nickname"
                       aria-required="true"
                       aria-describedby="displayname-hint"
                       placeholder=" "/>
                <label asp-for="DisplayName" for="DisplayName" class="auth-label">Display name</label>
                <span id="displayname-hint" class="auth-help">Shown on the leaderboard.</span>
                <span asp-validation-for="DisplayName" class="auth-err" role="alert" aria-live="polite"></span>
            </div>

            <div class="auth-field">
                <input asp-for="Email"
                       id="Email"
                       class="auth-input"
                       type="email"
                       autocomplete="username"
                       aria-required="true"
                       placeholder=" "/>
                <label asp-for="Email" for="Email" class="auth-label">Email</label>
                <span asp-validation-for="Email" class="auth-err" role="alert" aria-live="polite"></span>
            </div>

            <div class="auth-field">
                <input asp-for="Password"
                       id="Password"
                       class="auth-input"
                       autocomplete="new-password"
                       aria-required="true"
                       aria-describedby="password-hint"
                       placeholder=" "/>
                <label asp-for="Password" for="Password" class="auth-label">Password</label>
                <span id="password-hint" class="auth-help">Min 8 chars · uppercase · digit · symbol.</span>
                <span asp-validation-for="Password" class="auth-err" role="alert" aria-live="polite"></span>
            </div>

            <div class="auth-field">
                <input asp-for="ConfirmPassword"
                       id="ConfirmPassword"
                       class="auth-input"
                       autocomplete="new-password"
                       aria-required="true"
                       placeholder=" "/>
                <label asp-for="ConfirmPassword" for="ConfirmPassword" class="auth-label">Confirm password</label>
                <span asp-validation-for="ConfirmPassword" class="auth-err" role="alert" aria-live="polite"></span>
            </div>

            <button type="submit" class="auth-cta">Create account</button>

            <p class="auth-switch">
                Already registered? <a asp-controller="Account" asp-action="Login">Sign in</a>
            </p>
        </form>

        <div class="auth-footer">Dark mode · Keyboard friendly · WCAG AA</div>
    </section>
</div>

@section Scripts {
    @await Html.PartialAsync("_ValidationScriptsPartial")
    <script>
        (function () {
            document.querySelectorAll('.auth-input').forEach(function (input) {
                input.addEventListener('blur', function () {
                    var err = input.parentElement.querySelector('.auth-err');
                    if (err && err.textContent.trim()) input.classList.add('input-error');
                    else input.classList.remove('input-error');
                });
            });
        })();
    </script>
}
