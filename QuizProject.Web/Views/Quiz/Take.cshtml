@model TakeQuizViewModel
@{
    ViewData["Title"] = $"Taking: {Model.QuizTitle}";
    var tileColors = new[] { "red", "blue", "amber", "green" };
    var letters = new[] { "A", "B", "C", "D", "E", "F" };
}

<div class="quiz-shell">
    <nav aria-label="Quiz breadcrumb" class="mb-3">
        <ol class="breadcrumb" style="--bs-breadcrumb-divider: '/';">
            <li class="breadcrumb-item">
                <a asp-controller="Quiz" asp-action="Index">Quizzes</a>
            </li>
            <li class="breadcrumb-item active" aria-current="page">@Model.QuizTitle</li>
        </ol>
    </nav>

    <div class="quiz-topline">
        <p class="quiz-eyebrow">Quiz · <span>@Model.QuizTitle</span></p>
        <div class="quiz-timer" role="timer" aria-live="off" id="quiz-timer">
            <span class="quiz-timer-dot" aria-hidden="true"></span>
            <span id="quiz-timer-value">00:00</span>
        </div>
    </div>

    <div aria-live="polite" aria-atomic="true" id="quiz-progress-announcement" class="visually-hidden"></div>

    <div class="progress-neon" id="quiz-progress-bar" role="progressbar"
         aria-label="Quiz progress"
         aria-valuenow="0"
         aria-valuemin="0"
         aria-valuemax="@Model.TotalQuestions">
        <div class="progress-neon-fill" id="progress-fill"></div>
    </div>

    <form asp-controller="Quiz" asp-action="Submit" method="post" id="quiz-form" novalidate>
        @Html.AntiForgeryToken()
        <input type="hidden" name="AttemptId" value="@Model.AttemptId"/>

        @for (var i = 0; i < Model.Questions.Count; i++)
        {
            var q = Model.Questions[i];
            var isFirst = i == 0;

            <section id="question-@i"
                     class="quiz-question q-card @(isFirst ? "" : "d-none")"
                     aria-labelledby="question-heading-@i"
                     data-question-index="@i">
                <div class="q-num">Question <strong>@(i + 1)</strong> of <strong>@Model.TotalQuestions</strong></div>
                <h2 class="q-text" id="question-heading-@i" tabindex="-1">@q.Text</h2>

                <input type="hidden" name="Selections[@i].QuestionId" value="@q.QuestionId"/>

                <fieldset class="answers" role="radiogroup" aria-labelledby="question-heading-@i">
                    <legend>Answer options for question @(i + 1)</legend>
                    @for (var a = 0; a < q.Answers.Count; a++)
                    {
                        var answer = q.Answers[a];
                        var answerId = $"answer-{i}-{answer.AnswerId}";
                        var color = tileColors[a % tileColors.Length];
                        var letter = letters[a % letters.Length];
                        <label class="ans" data-c="@color" for="@answerId">
                            <input type="radio"
                                   class="quiz-answer-radio"
                                   id="@answerId"
                                   name="Selections[@i].SelectedAnswerId"
                                   value="@answer.AnswerId"
                                   required
                                   aria-required="true"/>
                            <span class="key" aria-hidden="true">@letter</span>
                            <span class="ans-text">@answer.Text</span>
                        </label>
                    }
                </fieldset>

                <div class="q-actions">
                    @if (i > 0)
                    {
                        <button type="button"
                                class="btn-ghost quiz-prev-btn"
                                data-target="@(i - 1)"
                                aria-label="Go to previous question">
                            &larr; Previous
                        </button>
                    }
                    else
                    {
                        <span></span>
                    }

                    <div class="q-hint" aria-hidden="true">
                        <kbd>A</kbd><kbd>B</kbd><kbd>C</kbd><kbd>D</kbd> · <kbd>Enter</kbd> next
                    </div>

                    @if (i < Model.Questions.Count - 1)
                    {
                        <button type="button"
                                class="btn-neon quiz-next-btn"
                                style="width: auto; padding-inline: 22px;"
                                data-target="@(i + 1)"
                                data-current="@i"
                                aria-label="Go to next question">
                            Next &rarr;
                        </button>
                    }
                    else
                    {
                        <button type="submit"
                                class="btn-neon quiz-submit-btn"
                                style="width: auto; padding-inline: 22px;"
                                data-current="@i"
                                aria-label="Submit quiz and see your results">
                            Submit quiz
                        </button>
                    }
                </div>
            </section>
        }
    </form>

    <div class="q-dots" aria-hidden="true" id="quiz-dots">
        @for (var i = 0; i < Model.TotalQuestions; i++)
        {
            <span class="q-dot @(i == 0 ? "current" : "")"></span>
        }
    </div>
</div>
