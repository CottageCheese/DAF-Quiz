@model QuestionFormModel
@{
    ViewData["Title"] = "Add question";
    var answers = new[] { Model.Answer1, Model.Answer2, Model.Answer3, Model.Answer4 };
    var fieldNames = new[] { "Answer1", "Answer2", "Answer3", "Answer4" };
}

<div class="admin-page">
    <header class="page-head">
        <div>
            <h1>Add question</h1>
            <p class="sub">Enter the question, order, and at least two answers. Mark the correct one.</p>
        </div>
    </header>

    <div class="a-form-wrap">
        <div asp-validation-summary="ModelOnly" class="a-summary" role="alert" aria-live="assertive"></div>

        <form asp-action="AddQuestion" method="post" class="a-form-card" novalidate>
            @Html.AntiForgeryToken()
            <input type="hidden" asp-for="QuizId"/>
            <input type="hidden" asp-for="QuestionId"/>

            <fieldset class="a-fieldset">
                <legend class="a-legend">Question</legend>

                <div class="a-field">
                    <label asp-for="Text" class="a-label req">Text</label>
                    <textarea asp-for="Text" class="a-textarea" rows="2"
                              placeholder="e.g. What is the capital of Australia?" autofocus
                              aria-required="true"></textarea>
                    <span asp-validation-for="Text" class="a-err" role="alert" aria-live="polite"></span>
                </div>

                <div class="a-field">
                    <label asp-for="DisplayOrder" class="a-label req">Display order</label>
                    <input asp-for="DisplayOrder" type="number" class="a-input" min="1" aria-required="true"/>
                    <span class="a-help">Lower numbers appear first.</span>
                    <span asp-validation-for="DisplayOrder" class="a-err" role="alert" aria-live="polite"></span>
                </div>
            </fieldset>

            <fieldset class="a-fieldset">
                <legend class="a-legend">Answers</legend>
                <p class="a-help" style="margin: 0 0 var(--s-3);">
                    At least 2 required. Select the radio next to the correct answer.
                </p>

                @for (var i = 0; i < 4; i++)
                {
                    var isRequired = i < 2;
                    <label class="a-answer">
                        <input type="radio" name="CorrectAnswerIndex" value="@i"
                               @(Model.CorrectAnswerIndex == i ? "checked" : "")
                               aria-label="Mark answer @(i + 1) as correct"/>
                        <input type="text" name="@fieldNames[i]"
                               placeholder="Answer @(i + 1)@(isRequired ? "" : " (optional)")"
                               aria-label="Answer @(i + 1)@(isRequired ? "" : " (optional)")"
                               aria-required="@(isRequired ? "true" : "false")"
                               value="@answers[i]"/>
                    </label>
                }
                <span asp-validation-for="CorrectAnswerIndex" class="a-err" role="alert" aria-live="polite"
                      style="margin-top: var(--s-2); display: block;"></span>
            </fieldset>

            <div class="a-form-actions">
                <button type="submit" class="a-btn a-btn--primary">Save question</button>
                <a asp-action="Details" asp-route-id="@Model.QuizId" class="a-btn">Cancel</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @await Html.PartialAsync("_ValidationScriptsPartial")
    <script>
        (function () {
            var form = document.querySelector('form.a-form-card');
            if (!form) return;
            form.addEventListener('submit', function () {
                setTimeout(function () {
                    var bad = form.querySelector('.a-err.field-validation-error, .input-validation-error');
                    if (bad) {
                        var focusable = bad.closest('.a-field,.a-fieldset')?.querySelector('input,textarea,select');
                        (focusable || bad).focus?.();
                        (focusable || bad).scrollIntoView({ block: 'center', behavior: 'smooth' });
                    }
                }, 0);
            });
        })();
    </script>
}
